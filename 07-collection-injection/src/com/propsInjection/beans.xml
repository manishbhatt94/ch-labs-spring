<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:util="http://www.springframework.org/schema/util"
	xsi:schemaLocation="
		http://www.springframework.org/schema/beans https://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/util https://www.springframework.org/schema/util/spring-util.xsd">


	<!-- Loading an entire Properties object straight from an external .properties 
		file on the classpath - the realistic way environment-specific config (dev/staging/prod) 
		is usually handled, instead of hardcoding it in XML. -->
	<util:properties id="appDefaults"
		location="classpath:com/propsInjection/app.properties" />
	<!-- Attribute : location - The location of the properties file, as a Spring 
		resource location: a URL, a "classpath:" pseudo URL, or a relative file path. 
		Multiple locations may be specified, separated by commas. Data Type : string -->


	<!-- <util:properties>'s attribute [local-override]'s default value is "false" -->
	<!-- Attribute : local-override - Specifies whether local properties override 
		properties from files. Default is "false": properties from files override 
		local defaults. If set to "true", local properties will override defaults 
		from files. Data Type : boolean. Default Value : false -->
	<util:properties id="appDefaultsDevelopment"
		location="classpath:com/propsInjection/app.properties">
		<!-- Note: Here <util:properties>'s [local-override] attribute's default 
			value "false" is applied. So, it means, the local properties are set first, 
			then the .properties file at [location] is loaded, and then the properties 
			in the file override the local properties. -->
		<prop key="app.environment">development</prop> <!-- Overridden by property from file -->
		<prop key="app.version">1.4.2-dev</prop> <!-- Overridden by property from file -->

		<!-- Add new prop. Works! - This property doesn't exist in file, so it's 
			not overridden. -->
		<prop key="app.logLevel">debug</prop>
		<!-- Add new prop. Works! - This property doesn't exist in file, so it's 
			not overridden. -->
		<prop key="app.strictAuth">disabled</prop>
	</util:properties>


	<util:properties id="appDefaultsDevOverriden"
		location="classpath:com/propsInjection/app.properties"
		local-override="true">
		<!-- Note: Here <util:properties>'s [local-override] attribute has been 
			explicitly set to value "true". So, it means, the .properties file at [location] 
			is loaded & those properties are set, then the local properties are set, 
			and so the local properties will override the properties specified in the 
			file. -->
		<prop key="app.environment">development</prop> <!-- Overrides the file's respective property value -->
		<prop key="app.version">1.4.2-dev</prop> <!-- Overrides the file's respective property value -->

		<prop key="app.logLevel">debug</prop> <!-- Add new prop. Works! -->
		<prop key="app.strictAuth">disabled</prop> <!-- Add new prop. Works! -->
	</util:properties>


	<util:properties id="databaseConfig">
		<prop key="mysql.url">jdbc://mysql:localhost:3306/users_db</prop>
		<prop key="mysql.username">root</prop>
		<prop key="mysql.password">manish</prop>
	</util:properties>


	<bean id="mailSender" class="com.propsInjection.MailSender">

		<!-- Structured form: <props>/<prop key="..."> - String key/value pairs 
			only. NOTE: unlike <map>, there is no key-ref / value-ref here - you simply 
			cannot inject a bean reference through <props>. -->
		<property name="mailServerSettings">
			<props>
				<prop key="mail.smtp.host">smtp.mailtrap.io</prop>
				<prop key="mail.smtp.auth">true</prop>
				<prop key="mail.smtp.starttls.enable">true</prop>
				<prop key="mail.smtp.port">25</prop>
				<prop key="mail.smtp.port">2525</prop> <!-- duplicate key -> overwrites 25 -->
			</props>
		</property>
		<!-- Result: mail.smtp.port ends up as 2525, same last-value-wins rule 
			as Map. -->

		<!-- Shortcut form: a plain multi-line <value>, parsed the same way Properties.load() 
			reads a .properties file - handy when you just want to paste key=value lines 
			directly. -->
		<property name="featureFlags">
			<value>
				darkMode=true
				betaSearch=false
				maxUploadSizeMB=25
			</value>
		</property>

	</bean>


</beans>
